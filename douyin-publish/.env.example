# 图形界面: npm start（macOS/Windows 优先 Chrome 应用模式窗口）
# 配置优先写入 client-settings.json（自动加载/保存）
# macOS Chrome: /Applications/Google Chrome.app
# Windows Chrome: 或设置 CHROME_PATH
# 以下为命令行模式或首次默认环境变量
API_HOST=47.113.125.61
API_PORT=8180
GRPC_PORT=9090

# 发布素材根目录；填写后会查找 PUBLISH_DIR/商品ID/视频文件
PUBLISH_DIR=

# 收到 start/启动 指令后轮询待发布商品的间隔，默认 60000 毫秒
PENDING_PUBLISH_POLL_INTERVAL_MS=60000

# 服务端登录账号（拉取任务、上报状态用）
SERVER_ACCOUNT=admin
SERVER_PASSWORD=123456

# 可选：API_DEBUG=1 打印请求调试信息
