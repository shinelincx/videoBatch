import { Component } from '@angular/core';

import { NzAlertModule } from 'ng-zorro-antd/alert';

@Component({
  selector: '<%= selector %>',
  imports: [NzAlertModule],
  <% if(inlineTemplate) { %>template: `<nz-alert nzType="success" nzMessage="Success Text" />`<% } else { %>templateUrl: './<%= dasherize(name) %>.component.html'<% } %>
})
export class <%= classify(name) %>Component {}
