[Unit]
Description=Video Publish Admin API
After=network.target mysqld.service redis-server.service
Wants=mysqld.service redis-server.service

[Service]
Type=simple
WorkingDirectory=/opt/video-publish-admin/current
EnvironmentFile=-/etc/sysconfig/video-publish-admin
ExecStart=/usr/bin/java -Xms256m -Xmx768m -jar /opt/video-publish-admin/current/video-publish-admin.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
